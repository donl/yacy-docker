# YaCy Search Server Configuration
# Copy to .env:  cp .env_example .env
# .env and .env.* are gitignored (secrets stay local)

# YaCy Version
# Use 'master' for latest development, or specify a release tag like 'Release_9.902_202312262252'
# See https://github.com/yacy/yacy_search_server/tags for available versions
YACY_VERSION=master

# Domain (for Traefik/Caddy reverse proxy templates)
YACY_DOMAIN=yacy.example.com

# Java Configuration
# Memory allocation (adjust based on available system memory)
# -Xmx2048m = max 2GB, -Xms512m = initial 512MB
JAVA_OPTS="-Xmx2048m -Xms512m"

# Timezone
TZ=UTC

# ============================================================================
# SOLR CONFIGURATION (Optional - via docker-compose.solr.yml overlay)
# ============================================================================
# To enable Solr:
#   ln -s docker-compose.solr.yml docker-compose.override.yml
#   docker compose up -d && ./bin/solr-init.sh

# Solr memory allocation
# SOLR_HEAP=2g

# Solr log level (WARN, INFO, DEBUG)
# SOLR_LOG_LEVEL=WARN

# Solr port (host binding)
# SOLR_PORT=127.0.0.1:8983

# ============================================================================
# BACKUP & RESTORE CONFIGURATION
# ============================================================================
# Directory where backups are stored (relative to project root)
# Can be overridden via BACKUP_DIR environment variable
# BACKUP_DIR=./backups

# Backup retention (days)
# How many days of backups to keep before automatic cleanup
# BACKUP_RETENTION_DAYS=7

